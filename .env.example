# =============================================================
# Variables de entorno - Moviendo Leyendas
# Copia este archivo a `.env` para desarrollo local.
# Para producción, configura las mismas variables en Railway/Vercel.
# NUNCA subas `.env` al repositorio.
# =============================================================

# ---------- Postgres local (docker-compose dev) ----------
POSTGRES_USER=cowork
POSTGRES_PASSWORD=cowork_dev_password
POSTGRES_DB=cowork_dev

# ---------- Backend ----------
NODE_ENV=development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=debug

# Local: postgres en contenedor
DATABASE_URL=postgres://cowork:cowork_dev_password@localhost:5432/cowork_dev
# Producción (ejemplo Supabase):
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-us-east-2.pooler.supabase.com:6543/postgres?sslmode=require

# CORS: lista separada por comas. Soporta wildcards *.dominio.com
CORS_ORIGIN=http://localhost:5173
# Producción ejemplo: CORS_ORIGIN=https://moviendoleyendas.vercel.app,*.vercel.app

# ---------- Staff backoffice ----------
# JWT_SECRET — cambiar OBLIGATORIAMENTE en producción (mínimo 32 chars aleatorios)
JWT_SECRET=ml-dev-secret-cambiame-en-produccion-2026
JWT_EXPIRES_DAYS=7
# Fallback legacy (mantener mientras se completa la migración a JWT en todos los endpoints)
ADMIN_TOKEN=axel123

# ---------- Supabase (opcional, solo si usas Auth/Storage directo) ----------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Frontend (Vite expone solo variables con prefijo VITE_) ----------
# En dev déjalo vacío para usar el proxy de Vite.
# En prod (Vercel) apunta al backend en Railway.
VITE_API_BASE_URL=
# Ejemplo prod: VITE_API_BASE_URL=https://moviendo-api.up.railway.app

# Proxy target solo para dev en docker (frontend container → backend container)
# VITE_PROXY_TARGET=http://backend:8000
