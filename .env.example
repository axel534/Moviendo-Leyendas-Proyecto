# =============================================================
# Variables de entorno del proyecto (ejemplo).
# Copia este archivo a `.env` y personaliza los valores.
# NUNCA subas `.env` al repositorio.
# =============================================================

# ---------- Postgres local (usado por docker-compose) ----------
POSTGRES_USER=cowork
POSTGRES_PASSWORD=cowork_dev_password
POSTGRES_DB=cowork_dev

# ---------- Backend ----------
NODE_ENV=development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=debug
DATABASE_URL=postgres://cowork:cowork_dev_password@localhost:5432/cowork_dev
CORS_ORIGIN=http://localhost:5173

# ---------- Supabase (dejar vacío en desarrollo local) ----------
# Llenar solo cuando apunten a staging/prod o al Supabase compartido
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Frontend (Vite expone solo variables con prefijo VITE_) ----------
VITE_API_BASE_URL=

# ---------- GCP (solo para CI/CD y despliegue) ----------
# GCP_PROJECT_ID=
# GCP_REGION=us-central1
# GCP_ARTIFACT_REGISTRY=
